// ==================== GPU COMPUTE SHADER IMPLEMENTATIONS ====================

unsigned int createComputeShader(const char* computePath)
{
    FILE* file = fopen(computePath, "r");
    if (!file) {
        printf("Failed to open compute shader: %s\n", computePath);
        return 0;
    }
    
    fseek(file, 0, SEEK_END);
    long length = ftell(file);
    fseek(file, 0, SEEK_SET);
    
    char* source = malloc(length + 1);
    fread(source, 1, length, file);
    source[length] = '\0';
    fclose(file);
    
    unsigned int shader = glCreateShader(GL_COMPUTE_SHADER);
    glShaderSource(shader, 1, (const char**)&source, NULL);
    glCompileShader(shader);
    
    int success;
    char infoLog[512];
    glGetShaderiv(shader, GL_COMPILE_STATUS, &success);
    if (!success) {
        glGetShaderInfoLog(shader, 512, NULL, infoLog);
        printf("Compute shader compilation failed:\n%s\n", infoLog);
        free(source);
        return 0;
    }
    
    unsigned int program = glCreateProgram();
    glAttachShader(program, shader);
    glLinkProgram(program);
    
    glGetProgramiv(program, GL_LINK_STATUS, &success);
    if (!success) {
        glGetProgramInfoLog(program, 512, NULL, infoLog);
        printf("Compute shader linking failed:\n%s\n", infoLog);
    }
    
    glDeleteShader(shader);
    free(source);
    
    return program;
}

void initGPUBuffers(Mesh* mesh, int maxInstances)
{
    // Create Shader Storage Buffer Objects for GPU compute
    glGenBuffers(1, &positionSSBO);
    glBindBuffer(GL_SHADER_STORAGE_BUFFER, positionSSBO);
    glBufferData(GL_SHADER_STORAGE_BUFFER, maxInstances * 3 * sizeof(float), NULL, GL_DYNAMIC_DRAW);
    
    glGenBuffers(1, &velocitySSBO);
    glBindBuffer(GL_SHADER_STORAGE_BUFFER, velocitySSBO);
    glBufferData(GL_SHADER_STORAGE_BUFFER, maxInstances * 3 * sizeof(float), NULL, GL_DYNAMIC_DRAW);
    
    glGenBuffers(1, &previousSSBO);
    glBindBuffer(GL_SHADER_STORAGE_BUFFER, previousSSBO);
    glBufferData(GL_SHADER_STORAGE_BUFFER, maxInstances * 3 * sizeof(float), NULL, GL_DYNAMIC_DRAW);
    
    glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0);
}

void cleanupGPUBuffers()
{
    if (positionSSBO) glDeleteBuffers(1, &positionSSBO);
    if (velocitySSBO) glDeleteBuffers(1, &velocitySSBO);
    if (previousSSBO) glDeleteBuffers(1, &previousSSBO);
}

void updatePhysicsGPU(unsigned int computeShader, Mesh* mesh, int numActive, float dt, int substeps, mfloat_t* containerPos)
{
    glUseProgram(computeShader);
    
    // Bind SSBOs
    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, positionSSBO);
    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, velocitySSBO);
    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 2, previousSSBO);
    
    // Set uniforms
    glUniform1f(glGetUniformLocation(computeShader, "dt"), dt / substeps);
    glUniform1i(glGetUniformLocation(computeShader, "numObjects"), numActive);
    glUniform3f(glGetUniformLocation(computeShader, "containerPos"), 
                containerPos[0], containerPos[1], containerPos[2]);
    glUniform1f(glGetUniformLocation(computeShader, "containerRadius"), CONTAINER_RADIUS);
    glUniform1f(glGetUniformLocation(computeShader, "objectRadius"), VERLET_RADIUS);
    
    // Dispatch compute shader for each substep
    for (int i = 0; i < substeps; i++) {
        glDispatchCompute((numActive + 255) / 256, 1, 1);
        glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT);
    }
    
    // Copy results back to rendering buffers
    glBindBuffer(GL_COPY_READ_BUFFER, positionSSBO);
    glBindBuffer(GL_COPY_WRITE_BUFFER, mesh->positionVBO);
    glCopyBufferSubData(GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, 
                        0, 0, numActive * 3 * sizeof(float));
    
    glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0);
    glUseProgram(0);
}

void updatePhysicsHybrid(unsigned int computeShader, Mesh* mesh, VerletObject* objects, 
                         int numActive, float dt, int substeps, mfloat_t* containerPos)
{
    // Hybrid approach: CPU for spatial partitioning, GPU for physics
    // This is a simplified version - in practice you'd do more sophisticated load balancing
    
    int cpuObjects = numActive / 4;  // 25% on CPU
    int gpuObjects = numActive - cpuObjects;  // 75% on GPU
    
    // CPU portion (using OpenMP)
    float sub_dt = dt / substeps;
    for (int i = 0; i < substeps; i++) {
        applyForcesOpenMP(objects, cpuObjects);
        applyConstraintsOpenMP(objects, cpuObjects, containerPos);
        updatePositionsOpenMP(objects, cpuObjects, sub_dt);
    }
    
    // GPU portion
    if (gpuObjects > 0) {
        updatePhysicsGPU(computeShader, mesh, gpuObjects, dt, substeps, containerPos);
    }
    
    // Copy CPU results to rendering buffer
    float* positions = malloc(cpuObjects * 3 * sizeof(float));
    for (int i = 0; i < cpuObjects; i++) {
        positions[i * 3 + 0] = objects[i].current[0];
        positions[i * 3 + 1] = objects[i].current[1];
        positions[i * 3 + 2] = objects[i].current[2];
    }
    
    glBindBuffer(GL_ARRAY_BUFFER, mesh->positionVBO);
    glBufferSubData(GL_ARRAY_BUFFER, 0, cpuObjects * 3 * sizeof(float), positions);
    glBindBuffer(GL_ARRAY_BUFFER, 0);
    
    free(positions);
}