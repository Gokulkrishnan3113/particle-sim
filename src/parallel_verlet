// ==================== PERFORMANCE METRICS ====================

void initPerformanceMetrics(PerformanceMetrics* metrics)
{
    metrics->avgFps = 0.0;
    metrics->minFps = DBL_MAX;
    metrics->maxFps = 0.0;
    metrics->avgPhysicsTime = 0.0;
    metrics->maxObjects = 0;
    metrics->totalFrames = 0;
    metrics->totalPhysicsTime = 0.0;
    metrics->fpsSum = 0.0;
}

void updatePerformanceMetrics(PerformanceMetrics* metrics, float dt, double physicsTime, int numObjects)
{
    double fps = 1.0 / dt;
    metrics->fpsSum += fps;
    metrics->totalFrames++;
    metrics->totalPhysicsTime += physicsTime;
    
    if (fps < metrics->minFps) metrics->minFps = fps;
    if (fps > metrics->maxFps) metrics->maxFps = fps;
    if (numObjects > metrics->maxObjects) metrics->maxObjects = numObjects;
    
    metrics->avgFps = metrics->fpsSum / metrics->totalFrames;
    metrics->avgPhysicsTime = metrics->totalPhysicsTime / metrics->totalFrames;
}

// ==================== OPENMP IMPLEMENTATIONS ====================

void applyForcesOpenMP(VerletObject* objects, int count)
{
    #pragma omp parallel for schedule(static)
    for (int i = 0; i < count; i++) {
        mfloat_t gravity[VEC3_SIZE] = {0.0f, -9.81f, 0.0f};
        vec3_add(objects[i].acceleration, objects[i].acceleration, gravity);
    }
}

void applyConstraintsOpenMP(VerletObject* objects, int count, mfloat_t* containerPos)
{
    #pragma omp parallel for schedule(static)
    for (int i = 0; i < count; i++) {
        VerletObject* obj = &objects[i];
        mfloat_t toObj[VEC3_SIZE];
        vec3_subtract(toObj, obj->current, containerPos);
        float dist = vec3_length(toObj);
        
        if (dist > CONTAINER_RADIUS - obj->radius) {
            mfloat_t n[VEC3_SIZE];
            vec3_normalize(n, toObj);
            vec3_multiply_f(n, n, CONTAINER_RADIUS - obj->radius);
            vec3_add(obj->current, containerPos, n);
        }
    }
}

void updatePositionsOpenMP(VerletObject* objects, int count, float dt)
{
    #pragma omp parallel for schedule(static)
    for (int i = 0; i < count; i++) {
        VerletObject* obj = &objects[i];
        mfloat_t velocity[VEC3_SIZE];
        vec3_subtract(velocity, obj->current, obj->previous);
        
        vec3_assign(obj->previous, obj->current);
        
        mfloat_t accel_term[VEC3_SIZE];
        vec3_multiply_f(accel_term, obj->acceleration, dt * dt);
        vec3_add(obj->current, obj->current, velocity);
        vec3_add(obj->current, obj->current, accel_term);
        
        vec3_zero(obj->acceleration);
    }
}

void applyGridCollisionsOpenMP(VerletObject* objects, int count)
{
    // Spatial grid collision detection with OpenMP
    const int gridDim = GRID_SIZE;
    const float cellSize = GRID_CELL_SIZE;
    const float invCellSize = 1.0f / cellSize;
    
    // Grid structure (simplified - thread-safe version)
    #pragma omp parallel for schedule(dynamic, 64)
    for (int i = 0; i < count; i++) {
        for (int j = i + 1; j < count; j++) {
            mfloat_t diff[VEC3_SIZE];
            vec3_subtract(diff, objects[i].current, objects[j].current);
            float dist = vec3_length(diff);
            float minDist = objects[i].radius + objects[j].radius;
            
            if (dist < minDist && dist > 0.0001f) {
                mfloat_t n[VEC3_SIZE];
                vec3_normalize(n, diff);
                float delta = minDist - dist;
                vec3_multiply_f(n, n, delta * 0.5f);
                
                #pragma omp critical
                {
                    vec3_add(objects[i].current, objects[i].current, n);
                    vec3_subtract(objects[j].current, objects[j].current, n);
                }
            }
        }
    }
}

// ==================== PTHREAD IMPLEMENTATIONS ====================

ParallelContext* initPthreadContext(int numThreads)
{
    ParallelContext* context = malloc(sizeof(ParallelContext));
    context->threads = malloc(sizeof(pthread_t) * numThreads);
    context->numThreads = numThreads;
    pthread_barrier_init(&context->barrier, NULL, numThreads);
    return context;
}

void freePthreadContext(ParallelContext* context)
{
    pthread_barrier_destroy(&context->barrier);
    free(context->threads);
    free(context);
}

void* applyForcesWorker(void* arg)
{
    ThreadWork* work = (ThreadWork*)arg;
    
    for (int i = work->startIdx; i < work->endIdx; i++) {
        mfloat_t gravity[VEC3_SIZE] = {0.0f, -9.81f, 0.0f};
        vec3_add(work->context->objects[i].acceleration, 
                 work->context->objects[i].acceleration, gravity);
    }
    
    return NULL;
}

void applyForcesPthread(VerletObject* objects, int count, ParallelContext* context)
{
    context->objects = objects;
    context->numActive = count;
    
    int chunkSize = (count + context->numThreads - 1) / context->numThreads;
    ThreadWork* works = malloc(sizeof(ThreadWork) * context->numThreads);
    
    for (int i = 0; i < context->numThreads; i++) {
        works[i].context = context;
        works[i].threadId = i;
        works[i].startIdx = i * chunkSize;
        works[i].endIdx = (i + 1) * chunkSize;
        if (works[i].endIdx > count) works[i].endIdx = count;
        
        pthread_create(&context->threads[i], NULL, applyForcesWorker, &works[i]);
    }
    
    for (int i = 0; i < context->numThreads; i++) {
        pthread_join(context->threads[i], NULL);
    }
    
    free(works);
}

